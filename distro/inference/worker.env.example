# Install as /etc/cgos/inference/worker.env after verifying these local assets.
# The operator token belongs in /var/lib/cgos-inference/operator-token (0600).
COMMUNITY_GRID_BACKEND=/opt/cgos/inference/llama-server
COMMUNITY_GRID_BACKEND_SHA256=4dbed0b2d945dd9752f8945942209e0eede6d4ad46c067a81f7051d0c3796963
COMMUNITY_GRID_MODEL=/opt/cgos/inference/qwen2.5-1.5b-instruct-q4_k_m.gguf
COMMUNITY_GRID_THREADS=4
COMMUNITY_GRID_MEMORY_MIB=4096
COMMUNITY_GRID_TIMEOUT=90
LD_LIBRARY_PATH=/opt/cgos/inference
