#!/bin/sh
set -eu
test "$(id -un)" = cgos-worker
test -z "${SSH_ORIGINAL_COMMAND:-}"
export PYTHONPATH=/opt/cgos/runtime PYTHONDONTWRITEBYTECODE=1
. /etc/cgos/distributed/worker.env
exec /usr/bin/python3 -m community_grid.physical /var/lib/cgos-worker/worker.db --coordinator "$CGOS_COORDINATOR" --node "$CGOS_NODE"
