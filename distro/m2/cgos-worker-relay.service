[Unit]
Description=CGOS restricted SSH worker relay
After=network.target cgos-worker.service
Requires=cgos-worker.service
ConditionPathExists=/etc/cgos/distributed/sshd_config

[Service]
Type=simple
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/sshd -t -f /etc/cgos/distributed/sshd_config
ExecStartPre=/usr/local/libexec/cgos-check-worker-sshd
ExecStart=/usr/sbin/sshd -D -e -f /etc/cgos/distributed/sshd_config
KillMode=control-group
ProtectSystem=strict
ReadWritePaths=/var/lib/cgos-worker
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=128M
TasksMax=32
TimeoutStopSec=10
